# Copy to .env (gitignored) and fill in. Never commit real values.

# NVIDIA Nemotron through an OpenAI-compatible endpoint (we used Nebius Token Factory)
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Zetaris REST API (local install defaults); create the API key in the Zetaris GUI
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=replace-me

# true = local data mirror + recorded model replies (no keys needed; the three sample questions only)
SAMPLE_MODE=false
